<?xml version="1.0" encoding="UTF-8"?>
<classpath>
  <classpathentry kind="src" path="src/main/java"/>
  <classpathentry kind="src" path="lo-hostile-apt-generated">
    <attributes>
      <attribute name="optional" value="true"/>
